# ── Google Sheets ─────────────────────────────────────────────────────────────
#
# HOW TO GET THIS URL:
#
# Option A — Recommended (most reliable):
#   1. Open the Google Sheet
#   2. File → Share → Publish to web
#   3. Select the correct tab → choose "Comma-separated values (.csv)"
#   4. Click "Publish" → copy the URL
#   5. Paste it below
#
# Option B — Sheet shared "Anyone with the link can view":
#   Replace SPREADSHEET_ID with the ID from your sheet's URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
#   Then use:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/export?format=csv&gid=0
#   (change gid=0 if your data is on a non-first tab)
#
GSHEET_CSV_URL=

# How long (in seconds) to cache the sheet data in memory between requests.
# 300 = 5 minutes. Set to 0 to always fetch fresh.
GSHEET_CACHE_TTL_SECONDS=300
