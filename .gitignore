# ── Dependencies ───────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output ───────────────────────────────────────────────────────────────
/.next/
/out/
/build

# ── Environment secrets — NEVER commit ────────────────────────────────────────
# .env.local.example is intentionally NOT listed here — it's a safe template
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Customer data — NEVER commit ──────────────────────────────────────────────
*.csv
*.log
snowflake.log

# ── macOS / IDE ────────────────────────────────────────────────────────────────
.DS_Store
*.pem
.vercel

# ── TypeScript ─────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Debug logs ─────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Testing ────────────────────────────────────────────────────────────────────
/coverage
